---
import '@fontsource-variable/manrope';
import '@fontsource/space-mono/400.css';
import '../styles/global.css';
import '../styles/cinematic.css';
import '../styles/atlas.css';
import Intro from '../components/Intro.astro';
import Icon from '../components/Icon.astro';
import {site,locales,defaultLocale,languageNames,href,tx,navigation,type Lang} from '../data/site';
import {liveSectors} from '../data/projects';
const {lang,title,description,path='',hero=false,noindex=false,image='/media/elewana-suite.webp',intro=false}=Astro.props as {lang:Lang;title:string;description?:string;path?:string;hero?:boolean;noindex?:boolean;image?:string;intro?:boolean};
const n=navigation[lang];
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#0c0d0d"/><title>{title} — Unmissabl</title><meta name="description" content={description||tx(lang,'an-international-filmmaking-collective-films-pho-a1810')}/><meta name="robots" content={site.demo||noindex?'noindex, nofollow':'index, follow'}/><link rel="canonical" href={site.url+href(lang,path)}/><>{locales.map(locale=><link rel="alternate" hreflang={locale} href={site.url+href(locale,path)}/>)}</><link rel="alternate" hreflang="x-default" href={site.url+href(defaultLocale,path)}/><meta property="og:title" content={title+' — Unmissabl'}/><meta property="og:description" content={description||tx(lang,'the-world-as-your-stage-your-brand-in-the-spotli-16b89')}/><meta property="og:image" content={site.url+image}/><meta property="og:url" content={site.url+href(lang,path)}/><meta property="og:type" content="website"/><meta property="og:locale" content={lang==='fr'?'fr_FR':'en_GB'}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/></head>
<body class:list={[hero?'with-hero':'without-hero']} data-lang={lang}>
<a class="skip-link" href="#main">{tx(lang,'skip-to-content-ba1ca')}</a>
{intro&&<Intro lang={lang}/>}
<header class="site-header"><a class="wordmark" href={href(lang)} aria-label={tx(lang,'unmissabl-home-77554')}>unmissabl</a><nav class="desktop-nav" aria-label={tx(lang,'main-navigation-aa3ac')}><a href={href(lang,'work')}>{n.work}</a><a href={href(lang,'sectors')}>{n.sector}</a><a href={href(lang,'atlas')}>{n.atlas}</a><a href={href(lang,'collective')}>{n.collective}</a></nav><div class="header-actions"><>{locales.filter(locale=>locale!==lang).map(locale=><a class="language" href={href(locale,path)} lang={locale} aria-label={languageNames[locale]}>{locale.toUpperCase()}</a>)}</><a class="header-contact outline-button" href={href(lang,'contact')}>{tx(lang,'have-a-project-in-mind-2c60a')}<Icon size={17}/></a><button class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu"><span>Menu</span><Icon name="menu"/></button></div></header>
<nav class="mobile-menu" id="mobile-menu" hidden aria-label={tx(lang,'mobile-navigation-e251f')}><a href={href(lang,'work')}>{n.work}</a><a href={href(lang,'sectors')}>{n.sector}</a><a href={href(lang,'atlas')}>{n.atlas}</a><a href={href(lang,'destinations')}>{n.destinations}</a><a href={href(lang,'collective')}>{n.collective}</a><a href={href(lang,'contact')}>{n.contact}</a></nav>
<main id="main"><slot/></main>
<footer class="footer"><div class="footer-top"><a class="footer-invite" href={href(lang,'contact')}>{tx(lang,'let-s-make-something-unforgettable-6c59b')}<Icon size={48}/></a><div><p>{tx(lang,'your-next-production-starts-here-cdd86')}</p><a class="text-link" href={'https://wa.me/'+site.whatsapp} target="_blank" rel="noopener">WhatsApp <Icon size={18}/></a><a class="text-link" href={'mailto:'+site.email}>{tx(lang,'email-us-5282e')}<Icon size={18}/></a></div></div><div class="footer-links"><div><a href={href(lang,'work')}>{n.work}</a><a href={href(lang,'atlas')}>{n.atlas}</a><a href={href(lang,'collective')}>{n.collective}</a><a href={href(lang,'destinations')}>{n.destinations}</a><a href={href(lang,'bespoke')}>{tx(lang,'bespoke-production-60bd7')}</a></div><div>{liveSectors.map(s=><a href={href(lang,'sectors/'+s.id)}>{s.name[lang]}</a>)}</div><div><a href={href(lang,'contact')}>Contact</a><a href={href(lang,'credits')}>{tx(lang,'credits-293a6')}</a><a href={href(lang,'privacy')}>{tx(lang,'privacy-89314')}</a><a href={href(lang,'proposal')}>{lang==='fr'?'Préparer une proposition':'Prepare a proposal'}</a><a href={href(lang,'intro')}>{lang==='fr'?'Films d’introduction':'Intro films'}</a><button class="replay-intro">{tx(lang,'replay-introduction-9379b')}</button></div></div><a class="footer-wordmark" href={href(lang)}>unmissabl</a><div class="footer-bottom"><span>© {new Date().getFullYear()} Unmissabl</span><span>{tx(lang,'the-world-as-your-stage-5bdbc')}</span><span>{tx(lang,'local-version-demonstration-1b603')}</span></div></footer>
<script>import '../scripts/client';import '../scripts/cinematic';if(document.querySelector('[data-atlas]'))void import('../scripts/atlas');</script>
</body></html>
