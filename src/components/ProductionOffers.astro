---
import {href,type Lang} from '../data/site';
import Icon from './Icon.astro';
const {lang,compact=false}=Astro.props as {lang:Lang;compact?:boolean};
const fr=lang==='fr';
const offers=fr?[
 {title:'Une campagne',body:'Lancer un produit, renouveler votre site ou accompagner un temps fort. Un tournage conçu pour plusieurs usages.',deliver:'Film principal, formats courts et photographies : une sélection définie ensemble.',action:'Préparer ma campagne'},
 {title:'Du contenu toute l’année',body:'Planifier vos prises de parole autour de nos départs. Vos produits voyagent ; votre équipe reste concentrée sur votre marque.',deliver:'Par exemple : 4 tournages dans l’année, avec des Reels et des photos livrés après chaque production. Le rythme et les volumes sont fixés au devis.',action:'Construire mon calendrier'},
 {title:'Plusieurs pays, une campagne',body:'Confier vos produits à nos réalisateurs sur place. Une même direction créative, plusieurs décors et un interlocuteur unique.',deliver:'Films et photos cohérents, adaptés à chaque marché. Équipes et lieux sélectionnés selon le brief.',action:'Explorer les destinations'}
]:[
 {title:'One campaign',body:'Launch a product, refresh your website or support a key moment. One shoot designed for several uses.',deliver:'A main film, short edits and photography: a selection we define together.',action:'Plan my campaign'},
 {title:'Content all year',body:'Plan your content around our production trips. Your products travel; your team stays focused on your brand.',deliver:'For example: 4 shoots a year, with Reels and photos delivered after each production. Frequency and quantities are agreed in the quote.',action:'Build my content calendar'},
 {title:'Several countries, one campaign',body:'Put your products in the hands of our local filmmakers. One creative direction, multiple settings and a single producer.',deliver:'Consistent films and photography, adapted to each market. Teams and locations selected around your brief.',action:'Explore the possibilities'}
];
---
<section class:list={['section','light','production-offers',{compact}]} id="offers">
 <div class="section-head"><h2>{fr?'Du contenu pour vos objectifs.':'Content for your goals.'}</h2><p>{fr?'Une campagne aujourd’hui. Une présence régulière demain. Nous organisons la production autour de vos besoins.':'A campaign today. A consistent presence tomorrow. We organise production around your needs.'}</p></div>
 <div class="offer-rows">{offers.map(o=><article><h3>{o.title}</h3><div><p>{o.body}</p><p class="offer-delivery">{o.deliver}</p><a class="text-link" href={href(lang,'contact')+'?project='+encodeURIComponent(o.title)}>{o.action}<Icon/></a></div></article>)}</div>
 <div class="shared-budget"><h3>{fr?'Ce que vous mutualisez. Ce qui reste à vous.':'What you share. What stays yours.'}</h3><div><p>{fr?'Le déplacement et la logistique d’un départ sont répartis entre plusieurs productions. Vous ne financez pas seul la mobilisation d’une équipe à l’international.':'Travel and trip logistics are shared across several productions. You do not fund the mobilisation of an international crew alone.'}</p><p>{fr?'Votre concept, vos séquences et vos livrables restent définis pour votre marque. Le devis précise la part mutualisée, la création, la postproduction, les droits d’utilisation et les éventuels frais spécifiques.':'Your concept, scenes and deliverables are defined for your brand. The quote sets out shared costs, creative work, post-production, usage rights and any project-specific expenses.'}</p><a class="text-link" href={href(lang,'contact')+'?project='+encodeURIComponent(fr?'Devis de production mutualisée':'Shared production quote')}>{fr?'Obtenir un devis détaillé':'Get an itemised quote'}<Icon/></a></div></div>
 <div class="cross-content"><div><h2>{fr?'Deux marques. Une histoire commune.':'Two brands. One shared story.'}</h2><p>{fr?'Un hôtel et une maison automobile. Une agence de voyage et un resort. Une montre et une voiture de collection. Nous réunissons des marques complémentaires autour d’un même tournage.':'A hotel and an automotive brand. A travel agency and a resort. A watch and a classic car. We bring complementary brands together for one production.'}</p><p>{fr?'Chaque partenaire dispose de contenus pour ses propres canaux. Une diffusion coordonnée permet à chacun de se faire découvrir par le public de l’autre.':'Each partner receives content for its own channels. Coordinated distribution gives each brand a chance to be discovered by the other’s audience.'}</p><p class="offer-delivery">{fr?'Nous organisons le concept, la recherche de partenaires, la production et le plan de diffusion. Association des marques, droits et publications sont validés ensemble avant le tournage.':'We organise the concept, partner search, production and distribution plan. Brand pairing, rights and posts are agreed together before the shoot.'}</p><a class="text-link" href={href(lang,'contact')+'?project='+encodeURIComponent(fr?'Collaboration entre marques':'Brand collaboration')}>{fr?'Imaginer une collaboration':'Plan a collaboration'}<Icon/></a></div><a class="cross-reference" href={href(lang,'projects/samuel-kwan-e69d32ce332f4aecb0c60b70c08ed0a4')}><img src="/media/samuel-kwan-e69d32ce332f4aecb0c60b70c08ed0a4.webp" alt="" loading="lazy" width="1280" height="720"/><span>Four Seasons Hong Kong × Mikimoto <Icon/></span><small>{fr?'Une référence du portfolio de Samuel Kwan. Découvrir la réalisation.':'A reference from Samuel Kwan’s portfolio. Explore the project.'}</small></a></div>
</section>
<style>
.production-offers.compact{padding-inline:0}.offer-rows article,.shared-budget{display:grid;grid-template-columns:1fr 1.35fr;gap:6vw;padding:32px 0;border-top:1px solid var(--line)}h3{font-size:clamp(23px,2.4vw,34px);font-weight:450;letter-spacing:-.025em;line-height:1.2}p{max-width:65ch;line-height:1.75;margin-bottom:20px}.offer-delivery{font-size:14px;color:var(--quiet)}.text-link{margin-top:10px}.shared-budget{margin-top:36px}.cross-content{display:grid;grid-template-columns:1.2fr 1fr;gap:7vw;margin-top:80px;align-items:center}.cross-content h2{margin-bottom:28px}.cross-reference img{width:100%;aspect-ratio:1;object-fit:cover}.cross-reference span{display:flex;justify-content:space-between;align-items:center;gap:14px;font-size:18px;margin-top:20px}.cross-reference small{display:block;line-height:1.65;margin-top:10px;color:var(--quiet)}@media(max-width:760px){.offer-rows article,.shared-budget,.cross-content{grid-template-columns:1fr;gap:22px}.cross-content{margin-top:50px;gap:32px}.offer-rows article{padding:28px 0}}
</style>
