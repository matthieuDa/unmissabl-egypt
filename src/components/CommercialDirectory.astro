---
import {commercialSectors} from '../data/commercial';
import {projectById} from '../data/projects';
import {href,type Lang} from '../data/site';
import Icon from './Icon.astro';
const {lang,compact=false}=Astro.props as {lang:Lang;compact?:boolean};const fr=lang==='fr';
const Heading=compact?'h2':'h1';
---
<section class:list={['section','light','commercial-directory',{'page-opening':!compact}]}>
 <div class="page-title"><Heading>{fr?'Votre activité. Votre production.':'Your business. Your production.'}</Heading><p>{fr?'Un site à renouveler, une saison à préparer, une campagne à lancer. Découvrez une approche adaptée à votre activité.':'A website to refresh, a season to plan, a campaign to launch. Explore an approach tailored to your business.'}</p></div>
 <div class="commercial-grid">{commercialSectors.map(s=><a href={href(lang,'solutions/'+s.id)}><img src={projectById(s.heroProject)!.poster} alt="" loading="lazy" width="1200" height="800"/><div><h2>{s.name[lang]}</h2><Icon/></div><p>{s.title[lang]}</p>{s.adjacent&&<small>{fr?'Approche proposée · références voyage et hôtellerie':'Proposed approach · travel and hospitality references'}</small>}</a>)}</div>
 <p class="commercial-other">{fr?'Une autre activité ?':'Another industry?'} <a href={href(lang,'sectors')}>{fr?'Explorer toutes les références sectorielles':'Explore all industry references'}</a></p>
</section>
<style>
.commercial-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:52px 30px}.commercial-grid>a{display:block;min-width:0}.commercial-grid img{width:100%;aspect-ratio:1.6;object-fit:cover}.commercial-grid>a>div{display:flex;align-items:center;justify-content:space-between;gap:18px;margin:20px 0 12px}.commercial-grid h2{font-size:clamp(26px,3vw,40px);font-weight:450;letter-spacing:-.03em;line-height:1.15}.commercial-grid p{font-size:16px;line-height:1.6;max-width:55ch}.commercial-grid small{display:block;margin-top:12px;font-size:12px;line-height:1.5;color:var(--quiet)}.commercial-other{margin-top:50px;font-size:16px;line-height:1.6}.commercial-other a{text-decoration:underline;text-underline-offset:5px}@media(max-width:650px){.commercial-grid{grid-template-columns:1fr;gap:35px}.commercial-grid img{aspect-ratio:1.4}.commercial-grid h2{font-size:28px}}
</style>
