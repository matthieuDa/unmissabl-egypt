---
import {geoOrthographic,geoPath,geoGraticule10} from 'd3-geo';
import {feature} from 'topojson-client';
import world from 'world-atlas/land-110m.json';
import {projects,projectCreditLine} from '../data/projects';
import {destinationCampaigns} from '../data/destination-campaigns';
import {destinations} from '../data/editorial';
import {href,type Lang} from '../data/site';
import Icon from './Icon.astro';
const {lang,compact=false,standalone=false}=Astro.props as {lang:Lang;compact?:boolean;standalone?:boolean};
const fr=lang==='fr';const Heading=standalone?'h1':'h2';
const copy=fr?{heading:'Nos tournages à travers le monde.',intro:'Explorez les destinations. Découvrez les films. Imaginez votre prochaine production.',work:'Tournages',future:'Prochains départs',base:'Bases du collectif',drag:'Faites tourner le globe',pause:'Mettre le globe en pause',resume:'Relancer la rotation',watch:'Voir le projet',loading:'Chargement du film',slow:'Le film se prépare. Encore quelques instants.',failed:'Cet aperçu est indisponible. Découvrez le film dans le projet.',play:'Lire l’aperçu',pauseVideo:'Mettre le film en pause',resumeVideo:'Reprendre le film',previous:'Destination précédente',next:'Destination suivante',choose:'Choisir une destination',films:'Films à découvrir',note:'Tournages réalisés, bases du collectif et prochains départs sont présentés séparément. La présence d’un talent ne préjuge pas de sa disponibilité.',baseTitle:'Notre collectif sur place',baseCredit:'Une équipe à composer selon votre projet et vos dates.',collective:'Découvrir le collectif',trip:'Découvrir le départ',empty:'Parlons de votre projet',sourceFilm:'Film disponible dans la fiche projet',static:'Les destinations restent accessibles dans la sélection ci-dessous.'}:{heading:'Our productions around the world.',intro:'Explore the destinations. Discover the films. Picture your next production.',work:'Shoot locations',future:'Upcoming trips',base:'Collective bases',drag:'Drag to explore the globe',pause:'Pause globe rotation',resume:'Resume globe rotation',watch:'View project',loading:'Loading the film',slow:'The film is getting ready. Just a moment.',failed:'This preview is unavailable. Explore the film in the project.',play:'Play preview',pauseVideo:'Pause film',resumeVideo:'Resume film',previous:'Previous destination',next:'Next destination',choose:'Choose a destination',films:'Films to discover',note:'Past shoots, collective bases and upcoming trips are shown separately. A talent’s presence does not establish their availability.',baseTitle:'Our collective on the ground',baseCredit:'An experienced team, assembled around your project and dates.',collective:'Meet the collective',trip:'Explore the trip',empty:'Tell us about your project',sourceFilm:'Watch the film on the project page',static:'Explore the destinations in the selection below.'};
type Media={id:string;title:string;credit:string;poster:string;video:string;embed?:string;url:string};
type Point={id:string;kind:'work'|'future'|'base';label:string;lat:number;lon:number;country:string;media:Media[]};
const points:Point[]=[];const places=new Map<string,Point>();
const hqPreview=(p:typeof projects[number])=>p.preview?.includes('/catalogue-preview-')?p.preview:'';
const priority=(p:typeof projects[number])=>p.id==='samuel-kwan-2d1c3c05ffa84f4a82ae28e3c2c4639a'?4:hqPreview(p)?3:p.videoUrl?2:p.format==='photo'?0:1;
for(const p of [...projects].filter(p=>p.location).sort((a,b)=>priority(b)-priority(a))){
 const location=p.location!;const labelFr=location.label.fr==='Tanzanie / Zanzibar'?'Tanzanie':location.label.fr;const labelEn=location.label.en==='Tanzania / Zanzibar'?'Tanzania':location.label.en;const key=labelFr.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
 const media={id:p.id,title:p.client,credit:projectCreditLine(p,lang),poster:p.poster,video:hqPreview(p),embed:p.embedUrl||p.videoUrl,url:href(lang,'projects/'+p.id)};
 const existing=places.get(key);
 if(existing){if(existing.media.length<5)existing.media.push(media);continue;}
 const point:Point={id:'work-'+p.id,kind:'work',label:fr?labelFr:labelEn,country:location.country[lang],lat:location.lat,lon:location.lon,media:[media]};places.set(key,point);points.push(point);
}
for(const d of destinations)points.push({id:'future-'+d.id,kind:'future',label:d.name[lang],country:'',lat:d.lat,lon:d.lon,media:[{id:d.id,title:d.name[lang],credit:d.period[lang]+' · '+d.status[lang],poster:destinationCampaigns[d.id as keyof typeof destinationCampaigns].image,video:'',url:href(lang,'destinations/'+d.id)}]});
// User-confirmed collective bases. A country is kept as a country; no city or talent is inferred.
const bases:[string,string,string,number,number][]=[['montreal','Montréal','Montréal',45.5019,-73.5674],['los-angeles','Los Angeles','Los Angeles',34.0522,-118.2437],['hong-kong','Hong Kong','Hong Kong',22.3193,114.1694],['dubai','Dubaï','Dubai',25.2048,55.2708],['paris','Paris','Paris',48.8566,2.3522],['vienna','Vienne','Vienna',48.2082,16.3738],['london','Londres','London',51.5072,-.1276],['bali','Bali','Bali',-8.4095,115.1889],['marrakech','Marrakech','Marrakesh',31.6295,-7.9811],['belgium','Belgique','Belgium',50.5039,4.4699],['tallinn','Tallinn','Tallinn',59.437,24.7536],['riviere-du-loup','Rivière-du-Loup','Rivière-du-Loup',47.8366,-69.5366],['monaco','Monaco','Monaco',43.7384,7.4246]];
// Tallinn: Tom Pacelli. Rivière-du-Loup: Dumont Films. Monaco: Creatum. Public bases recorded in editorial.ts.
for(const [id,labelFr,labelEn,lat,lon]of bases)points.push({id:'base-'+id,kind:'base',label:fr?labelFr:labelEn,country:'',lat,lon,media:[{id,title:copy.baseTitle,credit:copy.baseCredit,poster:'',video:'',url:href(lang,'collective')}]});
const first=points.find(p=>p.kind==='work')!;const firstMedia=first.media[0];
const patternId=`globe-land-dots-${standalone?'page':'home'}-${lang}`;const shadeId=`globe-shade-${standalone?'page':'home'}-${lang}`;
const projection=geoOrthographic().translate([320,320]).scale(276).rotate([-first.lon,-first.lat]).clipAngle(90);const path=geoPath(projection);const land=feature(world as any,(world as any).objects.land);
---
<section class:list={['atlas','atlas-globe',{compact}]} data-atlas data-points={JSON.stringify(points)} data-copy={JSON.stringify(copy)} data-lang={lang}>
 <div class="atlas-heading"><Heading>{copy.heading}</Heading><p>{copy.intro}</p></div>
 <div class="atlas-controls" role="group" aria-label={copy.choose}>
  <button data-map-filter="work" aria-pressed="true">{copy.work}<span>{points.filter(p=>p.kind==='work').length}</span></button>
  <button data-map-filter="future" aria-pressed="false">{copy.future}<span>{destinations.length}</span></button>
  <button data-map-filter="base" aria-pressed="false">{copy.base}<span>{bases.length}</span></button>
 </div>
 <div class="atlas-stage">
  <div class="atlas-globe-column">
   <div class="globe-canvas" data-globe-canvas tabindex="0" role="group" aria-label={copy.drag}>
    <svg class="globe-drawing" viewBox="0 0 640 640" aria-hidden="true"><defs><pattern id={patternId} width="5" height="5" patternUnits="userSpaceOnUse"><circle cx="2.5" cy="2.5" r=".9" fill="#e5e7df"/></pattern><radialGradient id={shadeId} cx="34%" cy="30%" r="75%"><stop offset="0%" stop-color="#101110" stop-opacity="0"/><stop offset="70%" stop-color="#101110" stop-opacity=".06"/><stop offset="100%" stop-color="#101110" stop-opacity=".82"/></radialGradient></defs><circle class="globe-orbit" cx="320" cy="320" r="313"/><path class="globe-ocean" d={path({type:'Sphere'})!}/><path class="globe-grid" data-globe-grid d={path(geoGraticule10())!}/><path class="globe-land" fill={`url(#${patternId})`} data-globe-land d={path(land as any)!}/><circle cx="320" cy="320" r="275" fill={`url(#${shadeId})`}/></svg>
    <div class="globe-points">{points.map(p=>{const [x,y]=projection([p.lon,p.lat])!;return <button class:list={['globe-point',{active:p===first}]} data-map-point={p.id} data-kind={p.kind} style={`--x:${x/6.4}%;--y:${y/6.4}%`} aria-label={p.label} aria-pressed={p===first?'true':'false'} hidden={p!==first}><span></span><em>{p.label}</em></button>})}</div>
   </div>
   <div class="globe-utilities"><p><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M3 12h18m-4-4 4 4-4 4M7 8l-4 4 4 4M12 3v18"/></svg>{copy.drag}</p><button data-globe-pause aria-label={copy.pause} aria-pressed="false"><Icon name="pause" size={16}/><span>{fr?'Pause':'Pause'}</span></button></div>
  </div>
  <div class="atlas-preview">
   <div class="atlas-media" data-atlas-media>
    <img data-map-poster src={firstMedia.poster} alt={firstMedia.title} width="1280" height="900" loading="lazy" decoding="async"/>
    <video data-map-video muted playsinline loop preload="none" aria-hidden="true" disablepictureinpicture></video>
    <div class="atlas-type-place" data-map-empty hidden><span data-map-empty-place>{first.label}</span><svg width="100%" height="50" viewBox="0 0 400 50" fill="none" aria-hidden="true"><path d="M0 25h400m-200-12v24" stroke="currentColor" stroke-width=".7"/></svg></div>
    <div class="atlas-loading" data-map-loading hidden role="status"><span class="atlas-loading-line"></span><span data-map-status>{copy.loading}</span></div>
    <a class="atlas-source-film" data-map-source-film href={firstMedia.url} hidden={!!firstMedia.video||!firstMedia.embed}><span><Icon name="play" size={22}/></span>{copy.sourceFilm}</a>
    <span class="atlas-place" data-map-place>{first.label}</span>
    <button class="atlas-video-control" data-map-pause hidden aria-label={copy.pauseVideo}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path data-map-pause-icon d="M8 5v14M16 5v14"/></svg></button>
   </div>
   <div class="atlas-caption" aria-live="polite" aria-atomic="true"><div><h3 data-map-title>{firstMedia.title}</h3><p data-map-credit>{firstMedia.credit}</p></div><a data-map-link href={firstMedia.url}><span data-map-link-label>{copy.watch}</span><Icon/></a></div>
   <div class="atlas-film-choices" data-map-films role="group" aria-label={copy.films} hidden></div>
  </div>
 </div>
 <div class="atlas-index-heading"><span data-map-count>{points.filter(p=>p.kind==='work').length} {fr?'destinations filmées':'shoot locations'}</span><div><button data-map-prev aria-label={copy.previous}><Icon/></button><button data-map-next aria-label={copy.next}><Icon/></button></div></div>
 <div class="atlas-location-index" aria-label={copy.choose}>{points.map(p=><button class="atlas-location-button" data-map-select={p.id} data-kind={p.kind} aria-pressed={p===first?'true':'false'} hidden={p.kind!=='work'}>{p.media[0].poster&&<span class="atlas-location-image"><img src={p.media[0].poster} alt="" width="240" height="144" loading="lazy" decoding="async"/>{(p.media[0].video||p.media[0].embed)&&<span><Icon name="play" size={16}/></span>}</span>}<span class="atlas-location-name">{p.label}<Icon size={14}/></span></button>)}</div>
 <p class="map-note">{copy.note}</p>
 <noscript><p class="map-note">{copy.static}</p></noscript>
</section>
