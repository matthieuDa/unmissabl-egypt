---
import {franceSectors} from '../data/france-campaign';
import {projectById, talentNames} from '../data/projects';
import {href,type Lang} from '../data/site';
import PreviewVideo from './PreviewVideo.astro';
import Icon from './Icon.astro';
const {lang}=Astro.props as {lang:Lang}; const fr=lang==='fr';
---
<section class="riviera-projects section light" id="projets" data-trip-sectors>
 <div class="riviera-intro"><h2>{fr?'Nous souhaitons travailler avec vous.':'We would like to work with you.'}</h2><p>{fr?'Au printemps 2027, nous préparons une production sur la Côte d’Azur. Nous échangeons dès maintenant avec les établissements et les marques de la région pour concevoir leurs films, choisir les décors et organiser les tournages ensemble.':'We are preparing a Côte d’Azur production for spring 2027. We are already speaking with local properties and brands to develop their films, choose settings and plan the shoots together.'}</p></div>
 <div class="riviera-tabs" role="tablist" aria-label={fr?'Votre activité pour ce voyage':'Your business for this production'}>{franceSectors.map((s,i)=><button type="button" id={'trip-tab-'+s.id} role="tab" aria-selected={i===0?'true':'false'} aria-controls={'trip-panel-'+s.id} tabindex={i===0?0:-1} data-sector-tab={s.id} data-sector-name={s.name[lang]}>{s.name[lang]}</button>)}</div>
 {franceSectors.map((s,i)=>{const p=projectById(s.reference)!;return <div class="riviera-panel" id={'trip-panel-'+s.id} role="tabpanel" aria-labelledby={'trip-tab-'+s.id} tabindex="0" hidden={i!==0} data-sector-panel={s.id}>
  <div class="riviera-proof"><a class="riviera-film project-image" style={p.id==='haras-de-prepinson'?'--film-ratio:1920/858':undefined} href={href(lang,'projects/'+p.id)} data-card-preview={p.preview||p.videoUrl} data-preview-orientation="landscape" data-preview-auto aria-label={(fr?'Découvrir la référence : ':'Explore the reference: ')+p.title}><img src={p.poster} alt={p.title} width="1600" height="1000" loading="lazy"/>{(p.preview||p.videoUrl)&&<PreviewVideo source={p.preview||p.videoUrl!} lang={lang}/>}<span class="riviera-film-link">{fr?'Découvrir la réalisation':'Explore the work'}<Icon size={20}/></span></a><div class="riviera-credit"><strong>{p.id==='haras-de-prepinson'?p.title:p.client}</strong><span>{talentNames(p)}{p.location?' · '+p.location.label[lang]:''}</span><small>{s.referenceLabel[lang]}</small></div>{s.supporting.length>0&&<div class="riviera-more">{s.supporting.map(id=>{const other=projectById(id)!;return <a href={href(lang,'projects/'+other.id)}><img src={other.poster} alt="" width="160" height="90" loading="lazy"/><span>{fr?'Autre référence hôtelière':'More hospitality work'}<strong>{other.client}</strong></span><Icon size={18}/></a>})}</div>}</div>
  <div class="riviera-proposal"><h3>{s.headline[lang]}</h3><p>{s.invitation[lang]}</p><div class="riviera-concept"><h4>{fr?'Une idée pour ce voyage':'An idea for this production'}</h4><p>{s.idea[lang]}</p></div><p class="riviera-formats">{s.deliverables[lang]}</p><a class="text-link riviera-cta" href="#brief" data-sector-brief={s.id}>{s.cta[lang]}<Icon size={20}/></a></div>
 </div>})}
 <p class="riviera-note">{fr?'Les films présentés sont des références de nos talents. Votre concept, vos livrables et votre budget sont définis avec vous.':'The films shown are references from our talents’ portfolios. Your concept, deliverables and budget are developed with you.'}</p>
</section>
<noscript><style is:global>.riviera-tabs{display:none!important}.riviera-panel[hidden]{display:grid!important;margin-top:64px}</style></noscript>
<script>import '../scripts/destination-sectors';</script>
<style>
.riviera-projects{scroll-margin-top:110px}.riviera-intro{display:grid;grid-template-columns:1fr 1fr;gap:8vw;align-items:start;margin-bottom:42px}.riviera-intro h2{font-size:clamp(34px,4vw,58px);max-width:16ch;line-height:1.1;font-weight:450;letter-spacing:-.03em}.riviera-intro>p{font-size:17px;line-height:1.75;max-width:60ch}.riviera-tabs{display:flex;gap:36px;overflow-x:auto;overscroll-behavior-inline:contain;border-bottom:1px solid #0c0d0d40;margin-bottom:42px;scrollbar-width:thin;scrollbar-color:#0c0d0d #e5e5df}.riviera-tabs button{font:inherit;color:#3e433e;background:none;border:0;border-bottom:2px solid transparent;min-height:58px;white-space:nowrap;cursor:pointer;padding:12px 0 20px;font-size:18px;flex:none}.riviera-tabs button[aria-selected=true]{color:#0c0d0d;border-bottom-color:currentColor}.riviera-tabs button:hover{color:#0c0d0d}.riviera-panel{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:5vw;align-items:start}.riviera-panel[hidden]{display:none}.riviera-film{display:block;aspect-ratio:var(--film-ratio,16/9);position:relative;overflow:hidden;background:var(--ink)}.riviera-film>img{width:100%;height:100%;object-fit:cover}.riviera-film video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0}.riviera-film.preview-playing video{opacity:1}.riviera-film-link{position:absolute;bottom:18px;left:20px;right:20px;display:flex;justify-content:space-between;align-items:center;color:#fff;font-size:13px;z-index:2;text-shadow:0 1px 5px #000}.riviera-film:after{content:'';position:absolute;inset:65% 0 0;background:linear-gradient(transparent,#0008);pointer-events:none}.riviera-credit{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:baseline;margin-top:18px}.riviera-credit strong{font-size:19px;font-weight:500}.riviera-credit span{font-size:12px;line-height:1.5}.riviera-credit small{display:block;flex-basis:100%;font-size:12px;color:#4c534c}.riviera-more{border-top:1px solid #0c0d0d30;margin-top:22px;padding-top:20px}.riviera-more a{display:flex;align-items:center;gap:16px}.riviera-more img{width:100px;height:64px;object-fit:cover}.riviera-more span{flex:1;font-size:11px;line-height:1.5}.riviera-more strong{display:block;font-size:14px;font-weight:500;margin-top:4px}.riviera-proposal h3{font-size:clamp(27px,2.8vw,40px);line-height:1.15;font-weight:450;letter-spacing:-.025em;text-wrap:balance;margin:0 0 22px;max-width:23ch}.riviera-proposal p{font-size:15px;line-height:1.8}.riviera-concept{margin:28px 0 22px}.riviera-concept h4{font-size:16px;font-weight:600;margin-bottom:9px}.riviera-formats{border-top:1px solid #0c0d0d30;padding-top:20px}.riviera-cta{margin-top:26px;min-height:48px;font-size:15px}.riviera-note{font-size:12px;line-height:1.7;max-width:80ch;margin:34px 0 0;color:#4c534c}.riviera-projects :is(button,a):focus-visible{outline:2px solid #0c0d0d;outline-offset:5px}.riviera-tabs button:focus-visible{outline-offset:-4px}.riviera-panel:focus-visible{outline:2px solid #0c0d0d;outline-offset:12px}@media(max-width:900px){.riviera-intro{gap:30px}.riviera-panel{grid-template-columns:minmax(0,1fr);gap:32px}.riviera-proposal{max-width:700px}.riviera-proposal h3{max-width:25ch}.riviera-tabs{gap:28px}.riviera-proposal p{font-size:16px}}@media(max-width:600px){.riviera-projects{scroll-margin-top:90px}.riviera-intro{grid-template-columns:1fr;gap:22px;margin-bottom:26px}.riviera-intro h2{font-size:36px}.riviera-intro>p{font-size:16px}.riviera-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin-bottom:26px;gap:0 24px;overflow:visible;border:0}.riviera-tabs button{min-width:0;min-height:60px;white-space:normal;text-align:left;font-size:16px;line-height:1.4;padding:12px 0;border-bottom:1px solid #0c0d0d40}.riviera-tabs button[aria-selected=true]{border-bottom:2px solid #0c0d0d}.riviera-film{aspect-ratio:var(--film-ratio,16/9)}.riviera-credit{display:block}.riviera-credit span,.riviera-credit small{display:block;margin-top:7px}.riviera-note{margin-top:28px}}
</style>
