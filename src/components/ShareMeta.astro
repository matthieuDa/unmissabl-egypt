---
import {site,href,type Lang} from '../data/site';
const {lang,path='',title,description,image='/social/unmissabl-cinematic-v1.jpg'}=Astro.props as {lang:Lang;path?:string;title:string;description:string;image?:string};
const home=path==='';
const sharingTitle=home?(lang==='fr'?'Unmissabl — Productions audiovisuelles internationales':'Unmissabl — International film production'):title+' — Unmissabl';
const sharingDescription=home?(lang==='fr'?'Films, photographie et contenus de marque. Productions mutualisées et sur mesure, partout dans le monde.':'Films, photography and branded content. Shared and bespoke productions around the world.'):description;
const sharingImage=home?'/social/unmissabl-cinematic-v1.jpg':image;
const imageUrl=new URL(sharingImage,site.url).href;
const imageType=/\.jpe?g$/i.test(sharingImage)?'image/jpeg':/\.png$/i.test(sharingImage)?'image/png':/\.webp$/i.test(sharingImage)?'image/webp':undefined;
const alt=home?(lang==='fr'?'Unmissabl — vue sur l’océan à Elewana Collection, Tanzanie.':'Unmissabl — ocean view at Elewana Collection, Tanzania.'):title;
---
<meta property="og:site_name" content="Unmissabl"/>
<meta property="og:title" content={sharingTitle}/>
<meta property="og:description" content={sharingDescription}/>
<meta property="og:image" content={imageUrl}/>
<meta property="og:image:secure_url" content={imageUrl}/>
{imageType&&<meta property="og:image:type" content={imageType}/>}
{home&&<><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/></>}
<meta property="og:image:alt" content={alt}/>
<meta property="og:url" content={site.url+href(lang,path)}/>
<meta property="og:type" content="website"/>
<meta property="og:locale" content={lang==='fr'?'fr_FR':'en_GB'}/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={sharingTitle}/>
<meta name="twitter:description" content={sharingDescription}/>
<meta name="twitter:image" content={imageUrl}/>
<meta name="twitter:image:alt" content={alt}/>
