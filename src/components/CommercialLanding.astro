---
import type {CommercialSector} from '../data/commercial';
import {href,type Lang} from '../data/site';
import {projectById,talentNames} from '../data/projects';
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import BriefForm from './BriefForm.astro';
const {lang,sector}=Astro.props as {lang:Lang;sector:CommercialSector};
const fr=lang==='fr';
const hero=projectById(sector.heroProject)!;
const references=sector.referenceIds.map(projectById).filter((p):p is NonNullable<typeof p>=>!!p);
const contact=href(lang,'contact')+'?sector='+encodeURIComponent(sector.name[lang])+'&project='+encodeURIComponent(sector.title[lang]);
---
<section class="commercial-hero">
 <img src={hero.poster} alt="" width="1800" height="1100" fetchpriority="high"/>
 <div class="commercial-opening"><a class="commercial-back" href={href(lang,'solutions')}>{fr?'Tous les secteurs':'All industries'}</a><h1>{sector.title[lang]}</h1><p>{sector.description[lang]}</p><a class="outline-button" href={contact}>{fr?'Recevoir un plan de production':'Get a production proposal'}<Icon/></a><a class="commercial-proof-link" href="#references">{fr?'Découvrir les références':'Explore the work'}<Icon size={18}/></a></div>
 <p class="commercial-caption">{hero.client} · {talentNames(hero)}{sector.adjacent?(fr?' · Référence voyage':' · Travel reference'):''}</p>
</section>
<section class="section light commercial-needs"><h2>{fr?'Des contenus utiles à votre activité.':'Content that serves your business.'}</h2><ul>{sector.outcomes.map(o=><li>{o[lang]}</li>)}</ul></section>
<section class="section light commercial-references" id="references"><div class="section-head"><h2>{fr?'Le travail de nos talents.':'Work by our talents.'}</h2><p>{sector.adjacent?(fr?'Ces références en voyage et hôtellerie illustrent notre approche de l’image. Elles ne sont pas présentées comme des réalisations pour un golf ou un haras.':'These travel and hospitality references illustrate our visual approach. They are not presented as golf or equestrian commissions.'):(fr?'Une sélection de projets issus des portfolios du collectif, avec les talents et les crédits de chaque réalisation.':'Selected projects from the collective’s portfolios, with the talent and credits for each production.')}</p></div><div class="project-grid">{references.map(project=><ProjectCard project={project} lang={lang}/>)}</div></section>
<section class="section dark commercial-delivery"><div><h2>{fr?'Un tournage. Plusieurs usages.':'One shoot. Several uses.'}</h2><p>{fr?'Nous préparons les formats dès le brief pour tirer le meilleur de chaque journée de tournage. Les quantités, durées, droits et délais sont écrits dans votre proposition.':'We plan formats from the brief to make the most of every shooting day. Quantities, durations, usage rights and timing are set out in your proposal.'}</p></div><ul>{sector.deliverables.map(item=><li>{item[lang]}</li>)}</ul></section>
<section class="section light commercial-model"><h2>{fr?'La qualité de production. Une organisation plus efficace.':'Production quality. A more efficient approach.'}</h2><div><h3>{fr?'Rejoindre un départ planifié':'Join a planned production'}</h3><p>{fr?'Sur nos productions mutualisées, plusieurs projets partagent une partie du déplacement et de la logistique. Votre concept et vos livrables restent propres à votre marque. Nous précisons les économies et les frais spécifiques dans le devis.':'On shared productions, several projects share part of the travel and logistics. Your concept and deliverables stay specific to your brand. Savings and project-specific expenses are detailed in the quote.'}</p><h3>{fr?'Tourner sur votre site':'Produce at your location'}</h3><p>{fr?'Votre lieu impose le décor ? Nous composons l’équipe selon votre activité, vos dates et votre budget. Notre réseau international permet aussi de coordonner plusieurs pays sous une même direction créative.':'Is your own location the setting? We assemble the team around your activity, dates and budget. Our international network also allows us to coordinate several countries under one creative direction.'}</p><a class="text-link" href={href(lang,'destinations')}>{fr?'Égypte 2026 et Côte d’Azur 2027':'Egypt 2026 and Côte d’Azur 2027'}<Icon/></a></div></section>
<section class="section dark commercial-rhythm"><article><h2>{fr?'Préparer toute une saison.':'Plan the whole season.'}</h2><p>{sector.annual[lang]}</p><p class="commercial-note">{fr?'Une mission ponctuelle ou un programme annuel : fréquence, livrables et budget sont définis ensemble.':'A one-off commission or annual programme: frequency, deliverables and budget are agreed together.'}</p></article><article><h2>{fr?'Créer avec une autre marque.':'Create with another brand.'}</h2><p>{sector.collaboration[lang]}</p><p class="commercial-note">{fr?'Exemples d’associations à construire, soumis à l’accord des partenaires. La diffusion est distincte de la production.':'Potential partnerships, subject to agreement by each brand. Distribution is scoped separately from production.'}</p></article></section>
<section class="section light commercial-next"><h2>{fr?'Du premier échange aux contenus prêts à publier.':'From the first conversation to content ready to publish.'}</h2><ol><li><strong>{fr?'Votre besoin':'Your brief'}</strong><span>{fr?'Objectif, supports, lieu et calendrier.':'Goals, channels, location and timing.'}</span></li><li><strong>{fr?'Une proposition précise':'A clear proposal'}</strong><span>{fr?'Concept, équipe, livrables, droits et budget.':'Concept, team, deliverables, rights and budget.'}</span></li><li><strong>{fr?'La production et la livraison':'Production and delivery'}</strong><span>{fr?'Tournage coordonné, montage et validation selon les étapes convenues.':'Coordinated filming, editing and approval at agreed stages.'}</span></li></ol><a class="text-link" href={contact}>{fr?'Parler de votre projet à Matthieu':'Discuss your project with Matthieu'}<Icon/></a></section>
<section class="section light commercial-brief" id="brief"><BriefForm lang={lang} context={sector.name[lang]}/></section>
<style>
.commercial-hero{position:relative;isolation:isolate;min-height:85svh;background:var(--ink);color:var(--paper);padding:155px var(--gutter) 80px;display:flex;align-items:end}.commercial-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}.commercial-hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#0c0d0ded,#0c0d0d60);z-index:-1}.commercial-opening{max-width:830px}.commercial-back{display:inline-flex;min-height:44px;align-items:center;font-size:14px;text-decoration:underline;text-underline-offset:5px;margin-bottom:22px}.commercial-opening h1{font-size:clamp(42px,5.4vw,76px);font-weight:450;line-height:1.08;letter-spacing:-.03em;text-wrap:balance}.commercial-opening>p{font-size:clamp(16px,1.4vw,20px);max-width:58ch;line-height:1.65;margin:28px 0 32px}.commercial-proof-link{display:inline-flex;gap:14px;min-height:48px;align-items:center;margin-left:24px;font-size:14px}.commercial-caption{position:absolute;bottom:22px;left:var(--gutter);right:var(--gutter);font-size:11px;line-height:1.5;color:#fff}.commercial-needs,.commercial-delivery,.commercial-model{display:grid;grid-template-columns:1fr 1.1fr;gap:7vw}.commercial-needs h2,.commercial-delivery h2,.commercial-model h2{max-width:17ch}.commercial-needs ul,.commercial-delivery ul{list-style:none;margin:0;padding:0}.commercial-needs li,.commercial-delivery li{padding:22px 0;border-top:1px solid var(--line);font-size:20px;line-height:1.5}.commercial-delivery li{border-color:#ffffff45}.commercial-delivery p,.commercial-model p,.commercial-rhythm p{line-height:1.75;max-width:65ch;margin-top:24px}.commercial-model h3{font-size:24px;line-height:1.3;font-weight:500;margin-top:36px}.commercial-model h3:first-child{margin-top:0}.commercial-model .text-link{margin-top:30px}.commercial-references{padding-top:0}.commercial-rhythm{display:grid;grid-template-columns:1fr 1fr;gap:8vw}.commercial-rhythm h2{font-size:clamp(30px,3vw,44px);max-width:18ch}.commercial-note{font-size:13px;color:#c9ccc5}.commercial-next h2{max-width:25ch}.commercial-next ol{list-style:decimal;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px;margin:45px 0;padding-left:24px}.commercial-next li{padding-left:6px;line-height:1.65}.commercial-next strong{display:block;font-size:20px;font-weight:500;margin-bottom:12px}.commercial-next span{font-size:15px}.commercial-brief{padding-top:0}.commercial-hero a:focus-visible{outline:2px solid #fff;outline-offset:5px}@media(max-width:760px){.commercial-hero{padding-top:130px;min-height:800px;min-height:95svh;padding-bottom:85px}.commercial-opening h1{font-size:clamp(36px,10vw,54px)}.commercial-opening>p{margin:24px 0}.commercial-proof-link{margin:10px 0 0}.commercial-needs,.commercial-delivery,.commercial-model,.commercial-rhythm{grid-template-columns:1fr;gap:32px}.commercial-needs li,.commercial-delivery li{font-size:18px}.commercial-rhythm{gap:50px}.commercial-next ol{grid-template-columns:1fr;gap:28px}.commercial-next h2{font-size:34px}.commercial-caption{font-size:10px}}
</style>
