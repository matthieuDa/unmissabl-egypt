---
import {href,tx,type Lang} from '../data/site';
import {projects,projectCreditLine,type Project} from '../data/projects';
import Icon from './Icon.astro';
import reels from '../data/reels.json';
const {lang,project=projects[0],title,description,sector}=Astro.props as {lang:Lang;project?:Project;title?:string;description?:string;sector?:string};
const montage=!sector;
---
<section class:list={['hero','cinema-hero',{'is-montage':montage}]} data-cinema-hero data-montage={montage?'true':undefined} data-preview={sector?project.preview:undefined}>
 <img class="hero-photo" src={montage?reels[0].poster:project.poster} alt={montage?'':project.title} fetchpriority="high" width="2000" height="1125"/>
 <video class="hero-video" data-hero-video muted autoplay playsinline loop preload="auto" aria-hidden="true">{montage?<><source src={reels[0].mobileSrc} media="(max-width: 760px)" type="video/mp4"/><source src={reels[0].src} type="video/mp4"/></>:<source src={project.preview} type="video/mp4"/>}</video>
 <div class="hero-shade"></div>
 <div class="hero-main"><h1>{title||tx(lang,'the-world-as-your-stage-your-brand-in-the-spotli-8ae09')}</h1><p>{description||tx(lang,'films-photography-and-social-content-shared-prod-66822')}</p><a class="text-link" href={sector?href(lang,'contact')+'?sector='+sector:'#sectors'}>{sector?tx(lang,'imagine-your-film-bef25'):tx(lang,'find-your-world-011f8')}<Icon/></a></div>
 <div class="hero-bottom">
 {montage?<div class="montage-caption"><a href={href(lang,'intro')} data-reel-title>{lang==='fr'?'Signature — films du collectif':'Signature — films by the collective'}</a><span data-reel-credit>{lang==='fr'?'Références de nos talents · découvrir les films':'Our talents’ work · explore the films'}</span></div>:<><div><a href={href(lang,'projects/'+project.id)}>{project.client}</a><span>{tx(lang,'from-our-talents-portfolios-0b2e2')}</span></div><div class="hero-credit"><span>{project.location?.label[lang]}</span><span>{projectCreditLine(project,lang)}</span></div></>}
 <div class="hero-media-actions"><span class="hero-buffer" data-hero-status role="status" hidden></span><a class="outline-button" href={montage?href(lang,'contact'):href(lang,'projects/'+project.id)+'#film'}>{montage?(lang==='fr'?'Recevoir une proposition':'Get a proposal'):<><Icon name="play"/>{tx(lang,'step-into-the-film-7b240')}</>}<Icon/></a></div>
 </div>
</section>
