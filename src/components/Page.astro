---
import {destinationCampaigns} from '../data/destination-campaigns';
import DestinationPage from './DestinationPage.astro';
import Reach from './Reach.astro';
import Proposal from './Proposal.astro';
import ProductionOffers from './ProductionOffers.astro';
import Proof from './Proof.astro';
import brands from '../data/brands.json';
import BrandLogos from './BrandLogos.astro';
import SectorGallery from './SectorGallery.astro';
import IntroFilms from './IntroFilms.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from './Hero.astro';import Atlas from './Atlas.astro';import ProjectCard from './ProjectCard.astro';import Film from './Film.astro';import BriefForm from './BriefForm.astro';import Destinations from './Destinations.astro';import Icon from './Icon.astro';
import {selections} from '../data/selections';
import {projects,liveSectors,talentNames,projectById} from '../data/projects';
import {talents,destinations} from '../data/editorial';
import {href,tx,type Lang} from '../data/site';
const {lang,path=''}=Astro.props as {lang:Lang;path:string};
const [kind,id]=path.split('/');
const project=projectById(id);const sector=liveSectors.find(s=>s.id===id);const destination=destinations.find(d=>d.id===id);
const picks=sector?projects.filter(p=>p.sectors.includes(sector.id)&&!p.portfolioOnly):projects;
const heroPicks:Record<string,string>={travel:'samuel-kwan-13f1b1ebf6bd49279b59821517b45d63',food:'samuel-kwan-8218e39818084803818865e4ff74b712',fashion:'tom-levis',automotive:'duarte-creatum-royal-rides-1',aviation:'robin-jetex',jewellery:'zaid-wazzan-behance-116879129',architecture:'chuck-dumont-royalmount-magil-tisseur'};
const landingHero=sector?projectById(heroPicks[sector.id])||picks[0]:picks[0];
const home=!kind;const landing=kind==='sectors'&&!!sector;
const title=kind==='proposal'?(lang==='fr'?'Votre proposition commerciale':'Your commercial proposal'):home?tx(lang,'the-world-as-your-stage-your-brand-in-the-spotli-16b89'):project?.title||sector?.name[lang]||destination?.name[lang]||({work:tx(lang,'our-talents-work-fc1ec'),atlas:tx(lang,'one-collective-one-world-f856c'),sectors:tx(lang,'a-world-for-every-brand-99a85'),collective:tx(lang,'perspectives-that-make-a-difference-224fb'),destinations:tx(lang,'our-next-journeys-5df58'),bespoke:tx(lang,'your-place-your-moment-2946c'),contact:tx(lang,'let-s-talk-about-your-project-e9aab'),credits:tx(lang,'credits-sources-a533f'),privacy:tx(lang,'privacy-89314'),intro:lang==='fr'?'Les films d’introduction':'Intro films',selections:tx(lang,'a-selection-for-your-brand-a258a')} as Record<string,string>)[kind]||'Unmissabl';
const selectionData=selections.find(s=>s.id===id)||selections[0];
const selection=selectionData.projectIds.map(id=>projectById(id)).filter((p):p is NonNullable<typeof p>=>!!p);
---
<SiteLayout lang={lang} path={path} title={title} description={sector?.description[lang]||project?.description[lang]||destination?.description[lang]} hero={home||landing} noindex={kind==='selections'||kind==='intro'||kind==='proposal'} image={destination?destinationCampaigns[destination.id as keyof typeof destinationCampaigns].image:project?.poster||picks[0].poster} intro={home||landing}>
{home&&<>
 <Hero lang={lang}/>
 <BrandLogos lang={lang}/>
 <section class="section light" id="sectors"><div class="sector-intro"><h2>{tx(lang,'your-world-our-next-destination-0671d')}</h2><p>{tx(lang,'an-international-collective-of-filmmakers-photog-56cb8')}</p></div><SectorGallery lang={lang}/></section>
 <ProductionOffers lang={lang}/>
 <Proof lang={lang}/>
 <Atlas lang={lang}/>
 <section class="section light production-section"><h2>{tx(lang,'one-journey-many-stories-yours-unmistakable-fd023')}</h2><div class="production-copy"><p class="lead">{tx(lang,'the-ambition-of-international-production-the-adv-314ee')}</p><p>{tx(lang,'we-bring-a-crew-together-in-one-destination-bran-b8bca')}</p><a class="text-link" href={href(lang,'destinations')}>{tx(lang,'our-next-journeys-5df58')}<Icon/></a><a class="text-link" href={href(lang,'bespoke')}>{tx(lang,'or-a-bespoke-production-e8c1e')}<Icon/></a></div><p class="production-worldwide">{lang==='fr'?'Votre campagne peut aussi prendre vie dans plusieurs pays à la fois. Nos réalisateurs sur place partagent une même direction créative : plusieurs décors, un seul interlocuteur, moins de déplacements.':'Your campaign can also come to life in several countries at once. Our local filmmakers share one creative direction: multiple settings, one producer, fewer journeys.'}</p><figure class="production-visual"><img src="/media/elewana-elephant.webp" alt={tx(lang,'elephant-photographed-during-the-elewana-product-57a3c')} loading="lazy" width="1800" height="750"/><figcaption>Elewana Collection · {lang==='fr'?'Tanzanie':'Tanzania'} · Chuck Dumont & Alexandre Buisson</figcaption></figure></section>
 <section class="section dark"><div class="section-head"><h2>{tx(lang,'on-the-horizon-d4832')}</h2><p>{tx(lang,'destinations-chosen-for-the-stories-they-make-po-ffa20')}</p></div><Destinations lang={lang}/></section>
 <section class="section light collective-teaser"><h2>{tx(lang,'places-inspire-perspective-changes-everything-371f4')}</h2><p>{tx(lang,'a-lead-filmmaker-for-your-project-matthieu-overs-80b1c')}</p><div class="talent-work-strip">{['tom-levis','duarte-creatum-columbia-1','robin-jetex'].map(id=>projectById(id)).filter(Boolean).map(p=><a href={href(lang,'projects/'+p!.id)}><img src={p!.poster} alt={p!.title} loading="lazy" width="700" height="600"/><span>{talentNames(p!)}</span></a>)}</div><a class="text-link" href={href(lang,'collective')}>{tx(lang,'meet-the-collective-da6a2')}<Icon/></a><a class="reach-home text-link" href={href(lang,'collective')+'#visibility'}>{tx(lang,'the-reach-of-the-work-e7522')}<Icon/></a></section>
 </>}
{landing&&sector&&<><Hero lang={lang} project={landingHero} title={sector.headline[lang]} description={sector.description[lang]} sector={sector.id}/><BrandLogos lang={lang} sector={sector.id}/><section class="section light"><div class="section-head"><h2>{tx(lang,'images-that-speak-your-language-dbc30')}</h2><p>{tx(lang,'a-selection-from-our-talents-portfolios-with-ori-1c700')}</p></div><div class="project-grid">{picks.map(p=><ProjectCard project={p} lang={lang}/>)}</div></section><section class="section dark deliverables"><h2>{tx(lang,'from-brand-film-to-the-first-scroll-4f84d')}</h2><div><p>{tx(lang,'we-shape-each-production-around-your-use-cases-t-cc3a4')}</p><ul>{sector.formats[lang].map(f=><li>{f}<Icon name="plus" size={18}/></li>)}</ul></div></section><section class="section light"><div class="section-head"><h2>{tx(lang,'the-right-perspectives-for-your-world-879df')}</h2></div><div class="talent-inline">{talents.filter(t=>picks.some(p=>p.creatorIds.includes(t.id))).map(t=><a href={href(lang,'collective')+'#'+t.id}>{t.name}<Icon/></a>)}</div></section><section class="section light" id="brief"><BriefForm lang={lang} context={sector.name[lang]}/></section></>}
{kind==='projects'&&project&&<><section class="project-opening section dark"><a class="back-link" href={href(lang,'work')}>{tx(lang,'all-selected-work-c676d')}<Icon/></a><h1>{project.title}</h1><div class="project-topline"><span>{talentNames(project)}</span><span>{project.location?.label[lang]||tx(lang,'collective-portfolio-ad8e2')}</span><span>{project.personal?tx(lang,'personal-film-b11f7'):project.portfolioOnly?tx(lang,'portfolio-film-57917'):tx(lang,'from-our-talents-portfolios-0b2e2')}</span></div><div id="film"><Film project={project} lang={lang}/></div>{project.socialUrl&&<div class="social-reference"><p>{tx(lang,'see-the-content-in-its-original-publication-6bb16')}</p><a class="text-link" href={project.socialUrl} target="_blank" rel="noopener">{tx(lang,'the-instagram-post-ffbb8')}<Icon/></a></div>}</section><section class="section light project-story"><h2>{project.client}</h2><div><p class="lead">{project.description[lang]}</p><dl class="credit-list"><dt>{lang==='fr'?'Talents du collectif':'Collective talents'}</dt><dd>{talentNames(project)}</dd><dt>{tx(lang,'credits-293a6')}</dt><dd><a href={href(lang,'credits')+'#project-'+project.id}>{lang==='fr'?'Crédits complets de la réalisation':'Full project credits'}</a></dd><dt>{tx(lang,'industries-08771')}</dt><dd>{project.sectors.map(s=>liveSectors.find(v=>v.id===s)).filter(Boolean).map(s=><a href={href(lang,'sectors/'+s!.id)}>{s!.name[lang]}</a>)}</dd></dl><a class="text-link" href={href(lang,'contact')+'?project='+encodeURIComponent(project.client)}>{tx(lang,'imagine-your-production-a5810')}<Icon/></a></div></section>{project.gallery.length>0&&<section class="project-gallery">{project.gallery.map((image,i)=><img src={image} alt={project.title+' — '+tx(lang,'photograph-fd019')+' '+(i+1)} loading="lazy" width="1600" height="1100"/>)}</section>}<section class="section light"><div class="section-head"><h2>{tx(lang,'keep-exploring-9e568')}</h2></div><div class="project-grid">{projects.filter(p=>p.id!==project.id&&p.sectors.some(s=>project.sectors.includes(s))).slice(0,2).map(p=><ProjectCard project={p} lang={lang}/>)}</div></section></>}
{kind==='work'&&<section class="section light page-opening"><div class="page-title"><h1>{title}</h1><p>{tx(lang,'films-and-images-that-speak-for-themselves-explo-706ac')}</p></div><div class="filters"><label>{tx(lang,'industry-65a6b')}<select data-filter="sector"><option value="">{tx(lang,'all-industries-8416c')}</option>{liveSectors.map(s=><option value={s.id}>{s.name[lang]}</option>)}</select></label><label>Format<select data-filter="format"><option value="">{tx(lang,'all-formats-96d90')}</option><option value="film">Film</option><option value="social">{tx(lang,'vertical-film-58541')}</option><option value="photo">{tx(lang,'photography-e99cf')}</option></select></label><label>{tx(lang,'location-7791e')}<select data-filter="place"><option value="">{tx(lang,'all-locations-ebc28')}</option>{[...new Set(projects.map(p=>p.location?.label[lang]).filter(Boolean))].map(p=><option value={p}>{p}</option>)}</select></label><button data-reset-filters>{tx(lang,'reset-e0e2a')}</button></div><p class="filter-count" aria-live="polite" data-filter-count>{projects.length} {tx(lang,'projects-d4e7e')}</p><div class="project-grid">{projects.map(p=><ProjectCard project={p} lang={lang}/>)}</div><div class="empty-state" data-empty hidden><h2>{tx(lang,'let-s-find-the-right-film-1be34')}</h2><p>{tx(lang,'try-another-filter-or-tell-us-what-you-need-785f6')}</p><a href={href(lang,'contact')}>{tx(lang,'let-s-talk-about-your-project-e9aab')}</a></div></section>}
{kind==='atlas'&&<div class="atlas-page"><Atlas lang={lang} standalone/><div class="atlas-bottom section dark"><h2>{tx(lang,'somewhere-else-in-mind-a0df1')}</h2><p>{tx(lang,'tell-us-where-and-when-we-will-explore-the-right-a5225')}</p><a class="outline-button" href={href(lang,'bespoke')}>{tx(lang,'shape-your-production-6eb86')}<Icon/></a></div></div>}
{kind==='sectors'&&!sector&&<section class="section light page-opening"><div class="page-title"><h1>{title}</h1><p>{tx(lang,'choose-your-industry-discover-the-work-talents-a-5033c')}</p></div><SectorGallery lang={lang} directory/><p>{tx(lang,'can-t-see-your-industry-here-let-s-build-a-selec-bb21d')} <a href={href(lang,'contact')}>{tx(lang,'contact-us-f02ff')}</a></p></section>}
{kind==='collective'&&<section class="section light page-opening"><div class="page-title"><h1>{title}</h1><p>{tx(lang,'a-perspective-for-every-project-a-team-shaped-ar-96bda')}</p></div><div class="talent-list">{talents.filter(t=>!t.producer).map(t=><article id={t.id}><h2>{t.name}</h2><div><span class="talent-role">{t.role[lang]}</span><p>{t.bio[lang]}</p>{t.base&&<p class="quiet">{t.base[lang]} · {tx(lang,'declared-base-39428')}</p>}<div class="talent-links">{projects.some(p=>p.creatorIds.includes(t.id))&&<a href={href(lang,'projects/'+projects.find(p=>p.creatorIds.includes(t.id))!.id)}>{tx(lang,'selected-work-5c35a')}<Icon size={16}/></a>}</div></div></article>)}</div><div class="producer-block"><h2>Matthieu<br/>Dalle-Berardinelli</h2><div><p class="lead">{tx(lang,'your-point-of-contact-from-the-first-conversatio-74b6f')}</p><p>{talents.find(t=>t.producer)!.bio[lang]}</p><a class="text-link" href={href(lang,'contact')}>{tx(lang,'let-s-talk-about-your-project-e9aab')}<Icon/></a></div></div><div class="visibility" id="visibility"><h2>{tx(lang,'the-images-and-their-reach-f6c89')}</h2><p>{tx(lang,'creator-distribution-is-an-optional-part-of-the-a05e0')}</p><Reach lang={lang}/></div></section>}
{kind==='destinations'&&!destination&&<section class="section dark page-opening"><div class="page-title"><h1>{title}</h1><p>{tx(lang,'shared-productions-that-give-your-brand-access-t-29b20')}</p></div><Destinations lang={lang}/><div class="bespoke-callout"><h2>{tx(lang,'does-your-project-take-us-somewhere-else-27c7e')}</h2><a class="text-link" href={href(lang,'bespoke')}>{tx(lang,'choose-your-place-and-timing-02509')}<Icon/></a></div></section>}
{destination&&<DestinationPage destination={destination} lang={lang}/>}
{kind==='bespoke'&&<><section class="section light page-opening"><div class="page-title"><h1>{title}</h1><p>{tx(lang,'tell-us-where-and-when-we-will-explore-the-right-a5225')}</p></div><div class="bespoke-story"><img src="/media/elewana-elephant.webp" alt={tx(lang,'elephant-photographed-during-the-elewana-product-57a3c')} loading="lazy"/><div><h2>{tx(lang,'the-world-goes-beyond-our-calendar-c3aec')}</h2><p>{tx(lang,'our-network-lets-us-explore-productions-around-t-1653c')}</p><p>{tx(lang,'we-work-with-your-brand-and-agency-a-shared-crea-21a57')}</p></div></div><ProductionOffers lang={lang} compact/><div id="brief"><BriefForm lang={lang} context={tx(lang,'bespoke-production-60bd7')}/></div></section></>}
{kind==='contact'&&<section class="section light page-opening contact-page"><div class="page-title"><h1>{title}</h1><p>{tx(lang,'a-clear-idea-or-the-start-of-one-tell-us-what-yo-f4ddf')}</p></div><BriefForm lang={lang}/></section>}
{kind==='selections'&&<section class="section light page-opening"><div class="page-title"><h1>{selectionData.title[lang]}</h1><p>{selectionData.description[lang]}</p></div><div class="project-grid">{selection.map(p=><ProjectCard project={p} lang={lang}/>)}</div><div class="section-tail"><a class="text-link" href={href(lang,'contact')+'?project='+encodeURIComponent(selectionData.context[lang])}>{tx(lang,'let-s-build-your-selection-bd20a')}<Icon/></a></div></section>}
{kind==='credits'&&<section class="section light page-opening prose"><h1>{title}</h1><p>{tx(lang,'the-work-shown-belongs-to-our-talents-portfolios-f1dd6')}</p><h2>{tx(lang,'films-photography-c4273')}</h2><ul>{projects.map(p=><li id={'project-'+p.id}><a href={href(lang,'projects/'+p.id)}>{p.title}</a> — {p.credit[lang]}</li>)}</ul><h2 id="brands">{lang==='fr'?'Marques et références':'Brands and references'}</h2><p>{lang==='fr'?'Les marques ci-dessous figurent dans les projets ou les listes de clients publiés par les talents. Les crédits identifient les talents concernés.':'The brands below appear in projects or client lists published by the talents. Credits identify the talents involved.'}</p><ul>{brands.filter(b=>b.entityType!=='agency-or-production').map(b=><li id={'brand-'+b.id}><strong>{b.name}</strong> — {b.creatorIds.map(id=>talents.find(t=>t.id===id)?.name).filter(Boolean).join(', ')}</li>)}</ul><h2>{tx(lang,'map-typography-8fdb5')}</h2><p>Natural Earth / world-atlas · Manrope · Space Mono (SIL Open Font License).</p><p>{tx(lang,'egypt-destination-photography-collection-from-th-081ab')}</p><p>{tx(lang,'a-credit-to-add-or-correct-b10ee')} <a href={href(lang,'contact')}>Contact</a></p></section>}
{kind==='privacy'&&<section class="section light page-opening prose"><h1>{title}</h1><h2>{tx(lang,'this-version-is-a-local-demonstration-e8cdd')}</h2><p>{tx(lang,'the-form-does-not-send-an-enquiry-fields-stay-in-6d635')}</p><h2>{tx(lang,'videos-external-services-a2dbb')}</h2><p>{tx(lang,'youtube-players-and-externally-hosted-films-load-8cbb4')}</p><h2>{tx(lang,'local-preferences-52463')}</h2><p>{tx(lang,'a-temporary-sessionstorage-flag-prevents-the-int-7e54e')}</p><p>{tx(lang,'retention-periods-the-data-controller-and-the-fo-d0991')}</p></section>}
{kind==='intro'&&<IntroFilms lang={lang}/>}
{kind==='proposal'&&<Proposal lang={lang}/>}
{kind==='404'&&<section class="section light page-opening"><h1>{tx(lang,'another-way-forward-fca87')}</h1><p>{tx(lang,'this-page-could-not-be-found-explore-the-films-a-00fc9')}</p><a class="text-link" href={href(lang)}>{tx(lang,'back-to-home-ff242')}<Icon/></a></section>}
</SiteLayout>
